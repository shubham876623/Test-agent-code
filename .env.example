# Application
APP_NAME="AI Accounting Platform"
APP_ENV=development
DEBUG=True
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/accounting_platform
# For production with connection pooling:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/accounting_platform

# Security
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
ENCRYPTION_KEY=your-fernet-encryption-key-base64-encoded
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
# Change to 'production' for live QuickBooks data

# VAPI (AI Voice)
VAPI_API_KEY=your-vapi-api-key
VAPI_API_URL=https://api.vapi.ai
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# N8n Webhook
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/

# Twilio (if using for SMS)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS (Bubble frontend domains)
CORS_ORIGINS=["http://localhost:3000","https://yourbubbleapp.bubbleapps.io"]

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourplatform.com

# Sentry (error tracking)
SENTRY_DSN=your-sentry-dsn-url

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Frontend URL (for redirects after OAuth)
FRONTEND_URL=http://localhost:3000
